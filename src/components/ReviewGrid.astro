---
import Icon from './Icon.astro';
import { reviewEmbed, reviewLinks, reviewThumb, type Review } from '../data/media';
import { lines } from '../data/content';

interface Props { items: Review[] }
const { items } = Astro.props;
---
<div class="reviews">
  {items.map((r, i) => (
    <button type="button" class:list={['review', { featured: i === 0 && items.length > 2 }]} data-line={r.line} data-glow
      data-media={JSON.stringify({ type: 'embed', src: reviewEmbed(r), title: r.title, links: reviewLinks(r) })}>
      <span class="thumb">
        <img src={reviewThumb(r)} width="960" height="540" alt={r.title} loading="lazy" decoding="async" />
        <span class="play"><Icon name="play" size={28} /></span>
        <span class="src">{r.rutube ? <><Icon name="rutube" size={14} />RuTube</> : <><Icon name="youtube" size={14} />YouTube</>}</span>
      </span>
      <span class="meta">
        <span class="tag">{lines[r.line]?.name}</span>
        <span class="title">{r.title}</span>
        <span class="author">{r.author}</span>
      </span>
    </button>
  ))}
</div>

<style>
  .reviews { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .review { --mx: 50%; --my: 50%; display: flex; flex-direction: column; text-align: left; padding: 0; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); overflow: hidden; color: inherit; transition: transform 0.4s var(--ease), border-color 0.3s, box-shadow 0.4s; }
  .review:hover { transform: translateY(-5px); border-color: rgba(138, 59, 255, 0.55); box-shadow: 0 24px 50px -20px rgba(106, 27, 255, 0.45); }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #000; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease), filter 0.4s; }
  .review:hover .thumb img { transform: scale(1.06); filter: saturate(1.15); }
  .play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: grid; place-items: center; width: 66px; height: 66px; border-radius: 50%; background: rgba(11, 12, 15, 0.6); border: 1px solid rgba(255, 255, 255, 0.35); backdrop-filter: blur(6px); transition: transform 0.4s var(--ease), background 0.3s; }
  .play :global(.icon) { margin-left: 4px; }
  .review:hover .play { background: var(--heat); border-color: transparent; transform: scale(1.12); }
  .src { position: absolute; left: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: 6px; background: rgba(0, 0, 0, 0.65); font: 700 12px/1.3 var(--font); }
  .meta { display: flex; flex-direction: column; gap: 6px; padding: 16px; }
  .tag { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-2); }
  .title { font-family: var(--display); font-weight: 600; font-size: 16px; line-height: 1.3; }
  .author { font-size: 13px; color: var(--muted); }
  .review[hidden] { display: none; }
  @media (min-width: 900px) { .review.featured { grid-column: span 2; } .review.featured .title { font-size: 20px; } }
</style>
