---
// Иконки сайта: соцсети и контакты. Рисуются линией в цвет текста, бренды — заливкой.
export type IconName = 'whatsapp' | 'telegram' | 'max' | 'vk' | 'youtube' | 'rutube' | 'phone' | 'mail' | 'pin' | 'clock' | 'truck' | 'box' | 'post' | 'card' | 'cart' | 'chat' | 'check' | 'doc' | 'route' | 'copy' | 'support' | 'play';
interface Props { name: IconName; size?: number; class?: string }
const { name, size = 20, class: className } = Astro.props;
const filled = ['whatsapp', 'telegram', 'max', 'vk', 'youtube', 'rutube', 'play'].includes(name);
---
<svg class:list={['icon', `icon-${name}`, className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"
  fill={filled ? 'currentColor' : 'none'} stroke={filled ? 'none' : 'currentColor'} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  {name === 'whatsapp' && (
    <>
      <path d="M12 2.2a9.7 9.7 0 0 0-8.4 14.6L2.3 21.7l5-1.3A9.7 9.7 0 1 0 12 2.2Zm0 1.8a7.9 7.9 0 1 1-4.1 14.7l-.3-.2-3 .8.8-2.9-.2-.3A7.9 7.9 0 0 1 12 4Z" />
      <path d="M9.1 7.3c-.2-.4-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.2.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.4-.3-1.7-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.4 6.4 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.3 0-.2 0-.3 0-.4l-.8-1.9Z" />
    </>
  )}
  {name === 'max' && <path transform="translate(2 2) scale(0.2)" fill-rule="evenodd" d="M50.76.26C78.29.26 99.89 22.6 99.89 50.15S77.61 99.49 51.02 99.49c-9.43 0-14-1.33-21.37-6.54a1.3 1.3 0 0 0-1.63.19C22.36 99.18 7.85 103.43 7.19 95.18 7.19 80.79 0 71.45 0 49.88 0 21.55 23.22.26 50.76.26Zm.77 24.55C38.46 24.13 28.26 33.2 26.01 47.38 24.15 59.13 27.45 73.45 30.28 74.18c1.2.3 4.08-1.9 6.18-3.88a1.2 1.2 0 0 1 1.45-.15c3.27 2 6.97 3.5 11.05 3.71 13.41.7 25.3-9.8 26-23.21.7-13.41-10.02-25.14-23.43-25.84Z" />}
  {name === 'telegram' && <path d="M21.4 3.6 2.9 10.8c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.1.8.7.8.5 0 .7-.2 1-.5l2.3-2.2 4.8 3.5c.9.5 1.5.3 1.7-.8l3.2-14.9c.3-1.4-.5-2-1.5-1.6ZM8.4 13.4l9.7-6.1c.5-.3.9-.1.5.2l-8.2 7.4-.3 3.4-1.7-4.9Z" />}
  {name === 'vk' && <path d="M12.9 17.6c-5.5 0-8.6-3.8-8.8-10h2.8c.1 4.6 2.1 6.5 3.7 6.9V7.6h2.6v4c1.6-.2 3.3-2 3.8-4h2.6a7.8 7.8 0 0 1-3.5 5.1 8.1 8.1 0 0 1 4.1 4.9h-2.9a5.1 5.1 0 0 0-4.1-3.7v3.7h-.3Z" />}
  {name === 'youtube' && <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15.1V8.9l5.2 3.1L10 15.1Z" />}
  {name === 'rutube' && <path d="M4 4h10.6c2.9 0 4.6 1.7 4.6 4.3 0 1.9-1 3.3-2.8 3.9L19.8 20h-3.6l-3-7.4H7.3V20H4V4Zm3.3 2.9v2.9h7c.9 0 1.5-.6 1.5-1.5s-.6-1.4-1.5-1.4h-7Z" />}
  {name === 'play' && <path d="M8 5.5v13a.8.8 0 0 0 1.2.7l10.2-6.5a.8.8 0 0 0 0-1.4L9.2 4.8A.8.8 0 0 0 8 5.5Z" />}
  {name === 'phone' && <path d="M5 3.5h3l1.5 4-2 1.3a11 11 0 0 0 5.7 5.7l1.3-2 4 1.5v3A2 2 0 0 1 16.4 19 14.5 14.5 0 0 1 3 5.6 2 2 0 0 1 5 3.5Z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" /></>}
  {name === 'pin' && <><path d="M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'truck' && <><path d="M2.5 6h11v10h-11zM13.5 9.5h4l3 3.5V16h-7" /><circle cx="6.5" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></>}
  {name === 'box' && <><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5v-9Z" /><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9" /></>}
  {name === 'post' && <><rect x="3" y="6" width="18" height="12" rx="2" /><path d="M7 10h5M7 13.5h3" /><rect x="14.5" y="9" width="3.5" height="4" rx=".6" /></>}
  {name === 'card' && <><rect x="2.5" y="5" width="19" height="14" rx="2.5" /><path d="M2.5 9.5h19M6.5 15h4" /></>}
  {name === 'cart' && <><path d="M3 4h2.2l2.3 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 8H6.2" /><circle cx="9.5" cy="20" r="1.3" /><circle cx="17.5" cy="20" r="1.3" /></>}
  {name === 'chat' && <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5v-9ZM8 8.5h8M8 11.5h5" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'doc' && <><path d="M6 3h8l4 4v14H6V3Z" /><path d="M14 3v4h4M9 12h6M9 15.5h6" /></>}
  {name === 'route' && <><circle cx="6" cy="18" r="2.5" /><circle cx="18" cy="6" r="2.5" /><path d="M8.5 18H15a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6.5" /></>}
  {name === 'copy' && <><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></>}
  {name === 'support' && <><path d="M4 13v-1a8 8 0 0 1 16 0v1" /><rect x="3" y="13" width="4" height="6" rx="1.5" /><rect x="17" y="13" width="4" height="6" rx="1.5" /><path d="M19 19a3 3 0 0 1-3 3h-3" /></>}
</svg>
