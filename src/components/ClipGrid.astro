---
import Icon from './Icon.astro';
import { clipPoster, clipSrc, type Clip } from '../data/media';
import { lines } from '../data/content';

interface Props { items: Clip[]; group?: string }
const { items, group = 'clips' } = Astro.props;
const mmss = (s: number) => `0:${String(s).padStart(2, '0')}`;
---
<div class="clips">
  {items.map((c) => (
    <button type="button" class="clip" data-group={group} data-line={c.line} data-glow
      data-media={JSON.stringify({ type: 'video', src: clipSrc(c), poster: clipPoster(c), title: c.title, links: [{ label: 'Пост в Telegram', href: c.post }] })}>
      <span class="frame">
        <img src={clipPoster(c)} width={c.w} height={c.h} alt={c.title} loading="lazy" decoding="async" />
        <video muted loop playsinline preload="none" data-preview={clipSrc(c)} aria-hidden="true"></video>
        <span class="rec"><i></i>REC</span>
        <span class="dur">{mmss(c.duration)}</span>
        <span class="play"><Icon name="play" size={24} /></span>
      </span>
      <span class="meta">
        <span class="line">{lines[c.line]?.name ?? 'RikaNV'}</span>
        <span class="title">{c.title}</span>
      </span>
    </button>
  ))}
</div>

<script>
  // На компьютере ролик оживает при наведении: грузим видео только в этот момент.
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('.clip').forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>('video')!;
      card.addEventListener('pointerenter', () => {
        if (!video.src) video.src = video.dataset.preview!;
        video.play().then(() => card.classList.add('is-playing')).catch(() => {});
      });
      card.addEventListener('pointerleave', () => { video.pause(); card.classList.remove('is-playing'); });
    });
  }
</script>

<style>
  .clips { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 16px; }
  .clip { --mx: 50%; --my: 50%; display: flex; flex-direction: column; gap: 12px; padding: 0 0 16px; text-align: left; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); overflow: hidden; color: inherit; transition: transform 0.4s var(--ease), border-color 0.3s; }
  .clip:hover { transform: translateY(-5px); border-color: rgba(138, 59, 255, 0.55); }
  .frame { position: relative; display: block; aspect-ratio: 4 / 3; background: #000; overflow: hidden; }
  .frame img, .frame video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease), opacity 0.4s; }
  .frame video { opacity: 0; }
  .clip.is-playing video { opacity: 1; }
  .clip:hover img { transform: scale(1.05); }
  .rec { position: absolute; left: 12px; top: 12px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: 6px; background: rgba(0, 0, 0, 0.6); font: 700 11px/1 var(--font); letter-spacing: 0.1em; }
  .rec i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: blink 1.2s steps(2, start) infinite; }
  .dur { position: absolute; right: 12px; bottom: 12px; padding: 3px 8px; border-radius: 6px; background: rgba(0, 0, 0, 0.6); font: 700 12px/1.4 var(--font); }
  .play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; background: rgba(11, 12, 15, 0.55); border: 1px solid rgba(255, 255, 255, 0.35); backdrop-filter: blur(6px); transition: transform 0.4s var(--ease), background 0.3s, opacity 0.3s; }
  .play :global(.icon) { margin-left: 3px; }
  .clip:hover .play { background: var(--heat); border-color: transparent; transform: scale(1.1); }
  .clip.is-playing .play { opacity: 0; }
  .meta { display: flex; flex-direction: column; gap: 4px; padding: 0 16px; }
  .line { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-2); }
  .title { font-weight: 600; font-size: 15px; line-height: 1.35; }
  .clip[hidden] { display: none; }
  @keyframes blink { to { opacity: 0; } }
</style>
