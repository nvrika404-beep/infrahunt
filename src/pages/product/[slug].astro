---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Consult from '../../components/Consult.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { products, type Product } from '../../lib/catalog';
import { lines } from '../../data/content';
import { site } from '../../data/site';
import ClipGrid from '../../components/ClipGrid.astro';
import ReviewGrid from '../../components/ReviewGrid.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { mediaFor } from '../../data/media';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: `rikanv-${product.slug}` }, props: { product } }));
}

const { product: p } = Astro.props as { product: Product };
const line = lines[p.line];
const media = mediaFor(p.slug, p.line);
const siblings = products.filter((x) => x.line === p.line && x.slug !== p.slug);
const related = [...siblings, ...products.filter((x) => x.category.slug === p.category.slug && x.line !== p.line && x.slug !== p.slug)].slice(0, 4);
const crumbs = [
  { href: '/', label: 'Главная' },
  { href: '/catalog/', label: 'Каталог' },
  { href: `/catalog/${p.category.slug}/`, label: p.category.title },
  { href: p.url, label: p.name },
];
const whatsappText = encodeURIComponent(`Здравствуйте! Хочу заказать ${p.name}${p.price ? ` (${p.priceText})` : ''}.`);
const fullName = `${p.category.kind} ${p.name}`;
const seoTitle = `${fullName} — купить, цена ${p.price ? p.priceText : 'по запросу'}`;
const seoDescription = `${fullName}. ${p.copy.lead} ${p.price ? `Цена ${p.priceText}.` : 'Цена по запросу.'} ${p.availabilityText}, доставка по России, гарантия производителя.`;

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.slug,
  brand: { '@type': 'Brand', name: 'RikaNV' },
  category: p.category.title,
  description: [p.copy.lead, ...p.copy.body].join(' '),
  image: p.images.map((img) => new URL(img.src, site.url).href),
  url: new URL(p.url, site.url).href,
  additionalProperty: p.copy.highlights.map(([name, value]) => ({ '@type': 'PropertyValue', name, value })),
  ...(p.price
    ? {
        offers: {
          '@type': 'Offer',
          url: new URL(p.url, site.url).href,
          price: p.price,
          priceCurrency: 'RUB',
          availability: `https://schema.org/${p.availability === 'InStock' ? 'InStock' : 'BackOrder'}`,
          itemCondition: 'https://schema.org/NewCondition',
          seller: { '@id': `${site.url}/#store` },
        },
      }
    : {}),
};
---
<Base title={seoTitle} description={seoDescription} image={p.images[0].src} jsonLd={[productLd]}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="wrap product" data-product={p.slug}>
    <div class="gallery" data-gallery>
      <div class="stage" data-glow>
        {p.copy.badge && <span class="chip chip-heat badge">{p.copy.badge}</span>}
        <div class="slides" data-slides>
          {p.images.map((img, i) => (
            <figure class="slide">
              <img src={img.src} width={img.w} height={img.h} alt={i === 0 ? p.name : `${p.name} — фото ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" />
            </figure>
          ))}
        </div>
        {p.images.length > 1 && <span class="counter" data-counter>1 / {p.images.length}</span>}
      </div>
      {p.images.length > 1 && (
        <div class="thumbs" role="tablist" aria-label="Фотографии">
          {p.images.map((img, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Фото ${i + 1}`} data-thumb={i}>
              <img src={img.thumb} width={img.w} height={img.h} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="info">
      <a class="line" href={`/catalog/${p.category.slug}/`}>{line.name} · {line.tagline}</a>
      <h1><span class="kind">{p.category.kind}</span> {p.name}</h1>
      <p class="lead">{p.copy.lead}</p>
      <dl class="highlights">
        {p.copy.highlights.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="buy" data-glow>
        <div class="price-row">
          <span class="price">{p.priceText}</span>
          <span class:list={['status', { 'is-instock': p.availability === 'InStock' }]}>{p.availabilityText}</span>
        </div>
        <div class="buy-buttons">
          {p.price ? (
            <button class="btn btn-primary" type="button" data-add-cart={p.slug}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2.2l2.3 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 8H6.2" /></svg>
              В корзину
            </button>
          ) : (
            <button class="btn btn-primary" type="button" data-lead="price" data-slug={p.slug}><Icon name="chat" size={18} />Узнать цену</button>
          )}
          <button class="btn btn-ghost" type="button" data-toggle-compare={p.slug} aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 20V10M12 20V4M19 20v-7" /></svg>
            <span data-label>Сравнить</span>
          </button>
        </div>
        {p.price && <button class="btn one-click" type="button" data-lead="quick" data-slug={p.slug}><span class="bolt" aria-hidden="true">⚡</span>Купить в 1 клик<small>без корзины, перезвоним за 15 минут</small></button>}
        <a class="quick" href={`${site.whatsapp}?text=${whatsappText}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />Или напишите в WhatsApp</a>
        <ul class="perks">
          <li>Гарантия производителя RikaNV</li>
          <li>Доставка СДЭК и Почтой России</li>
          <li>Оплата по счёту после подтверждения</li>
        </ul>
      </div>
    </div>
  </section>

  <nav class="wrap tabs" aria-label="Разделы страницы">
    <a href="#opisanie">Описание</a>
    <a href="#harakteristiki">Характеристики</a>
    {(media.clips.length > 0 || media.reviews.length > 0) && <a href="#video">Видео</a>}
    {p.johnson && <a href="#dalnosti">Дальности</a>}
    {related.length > 0 && <a href="#pohozhie">Похожие модели</a>}
  </nav>

  <section class="wrap block" id="opisanie" aria-labelledby="desc-title">
    <h2 id="desc-title">Описание {p.name}</h2>
    <div class="prose">{p.copy.body.map((text) => <p>{text}</p>)}</div>
  </section>

  {(media.clips.length > 0 || media.reviews.length > 0) && (
    <section class="wrap block" id="video" aria-labelledby="video-title">
      <div class="section-head">
        <h2 id="video-title">Видео {line.name}</h2>
        <a class="btn btn-ghost btn-sm" href="/video/">Все видео</a>
      </div>
      {media.reviews.length > 0 && <ReviewGrid items={media.reviews.slice(0, 3)} />}
      {media.clips.length > 0 && (
        <>
          <h3 class="sub-h">Записи с прибора</h3>
          <ClipGrid items={media.clips.slice(0, 4)} group="product-clips" />
        </>
      )}
      {media.photos.length > 0 && (
        <>
          <h3 class="sub-h">Трофеи и прибор в деле</h3>
          <PhotoGallery items={media.photos.slice(0, 4)} group="product-photos" />
        </>
      )}
    </section>
  )}

  <section class="wrap block" id="harakteristiki" aria-labelledby="specs-title">
    <h2 id="specs-title">Характеристики</h2>
    <div class="specs">
      {p.groups.map((g, i) => (
        <details class="spec-group" open={i < 3}>
          <summary>{g.title}<span aria-hidden="true"></span></summary>
          <dl>
            {g.rows.map(([n, v]) => <div><dt>{n}</dt><dd>{v}</dd></div>)}
          </dl>
        </details>
      ))}
    </div>
  </section>

  {p.johnson && (
    <section class="wrap block" id="dalnosti" aria-labelledby="range-title">
      <h2 id="range-title">Расчётные дальности по критерию Джонсона</h2>
      <p class="muted range-note">Для объектива {p.johnson.lens}. Это теоретический расчёт: в поле дистанции зависят от погоды, влажности и теплового контраста.</p>
      <div class="table-scroll">
        <table class="range">
          <thead><tr><th scope="col">Цель</th>{p.johnson.targets.map((t) => <th scope="col">{t[0].toUpperCase() + t.slice(1)}</th>)}</tr></thead>
          <tbody>{p.johnson.rows.map((r) => <tr><th scope="row">{r.label}</th>{r.values.map((v) => <td>{v}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="wrap block" id="pohozhie" aria-labelledby="rel-title">
      <div class="section-head">
        <h2 id="rel-title">{siblings.length ? `Другие модели ${line.name}` : 'Похожие модели'}</h2>
        <a class="btn btn-ghost btn-sm" href="/compare/" data-compare-set={[p.slug, ...related.slice(0, 3).map((x) => x.slug)].join(',')}>Сравнить с похожими</a>
      </div>
      <div class="grid">{related.map((x) => <ProductCard product={x} />)}</div>
    </section>
  )}

  <section class="wrap block"><Consult product={p.name} slug={p.slug} /></section>

  <div class="sticky-buy" data-sticky>
    <div class="wrap sticky-inner">
      <span class="sticky-name">{p.name}<b>{p.priceText}</b></span>
      <span class="sticky-actions">
        {p.price && <button class="btn btn-ghost btn-sm" type="button" data-lead="quick" data-slug={p.slug}>В 1 клик</button>}
        {p.price
          ? <button class="btn btn-primary btn-sm" type="button" data-add-cart={p.slug}>В корзину</button>
          : <button class="btn btn-primary btn-sm" type="button" data-lead="price" data-slug={p.slug}>Узнать цену</button>}
      </span>
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const slides = gallery.querySelector<HTMLElement>('[data-slides]')!;
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const counter = gallery.querySelector<HTMLElement>('[data-counter]');
    const mark = () => {
      const i = Math.round(slides.scrollLeft / slides.clientWidth);
      thumbs.forEach((t, n) => t.setAttribute('aria-selected', String(n === i)));
      if (counter) counter.textContent = `${i + 1} / ${thumbs.length}`;
    };
    slides.addEventListener('scroll', () => requestAnimationFrame(mark), { passive: true });
    thumbs.forEach((t, i) => t.addEventListener('click', () => slides.scrollTo({ left: slides.clientWidth * i, behavior: 'smooth' })));
  });
  // Кнопка «В корзину» внизу экрана, когда основная ушла из вида.
  const sticky = document.querySelector<HTMLElement>('[data-sticky]');
  const buy = document.querySelector('.buy');
  if (sticky && buy) {
    new IntersectionObserver(([entry]) => sticky.classList.toggle('is-visible', !entry.isIntersecting && entry.boundingClientRect.top < 0)).observe(buy);
  }
</script>

<style>
  .product { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(24px, 4vw, 56px); padding-top: 22px; }
  .gallery { position: sticky; top: 130px; align-self: start; min-width: 0; }
  .stage { --mx: 50%; --my: 50%; position: relative; border-radius: calc(var(--radius) + 6px); border: 1px solid var(--line); overflow: hidden;
    background: radial-gradient(500px circle at var(--mx) var(--my), rgba(255, 90, 31, 0.12), transparent 60%), radial-gradient(80% 80% at 50% 60%, #22252e, var(--surface) 75%); }
  .slides { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .slides::-webkit-scrollbar { display: none; }
  .slide { position: relative; flex: 0 0 100%; margin: 0; aspect-ratio: 1; scroll-snap-align: start; }
  .slide img { position: absolute; inset: 8%; width: 84%; height: 84%; object-fit: contain; filter: drop-shadow(0 26px 34px rgba(0, 0, 0, 0.6)); transition: transform 0.6s var(--ease); }
  .stage:hover .slide img { transform: scale(1.04); }
  .badge { position: absolute; top: 18px; left: 18px; z-index: 1; }
  .counter { position: absolute; right: 16px; bottom: 14px; font-size: 13px; font-weight: 700; color: var(--muted); }
  .thumbs { display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; scrollbar-width: thin; padding-bottom: 4px; }
  .thumbs button { flex: 0 0 78px; height: 78px; padding: 8px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); transition: border-color 0.2s, transform 0.2s; }
  .thumbs button:hover { transform: translateY(-2px); border-color: var(--line-strong); }
  .thumbs button[aria-selected='true'] { border-color: var(--accent-2); }
  .thumbs img { width: 100%; height: 100%; object-fit: contain; }

  .info { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .line { font-size: 13px; font-weight: 700; color: var(--accent-2); letter-spacing: 0.04em; }
  .line:hover { color: var(--gold); }
  .lead { font-size: 18px; color: #d4d3cf; }
  .kind { display: block; font-family: var(--font); font-size: 15px; font-weight: 600; letter-spacing: 0; color: var(--muted); margin-bottom: 8px; }
  .highlights { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0; }
  .highlights div { padding: 14px 16px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface); transition: border-color 0.3s; }
  .highlights div:hover { border-color: rgba(255, 122, 26, 0.45); }
  .highlights dt { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; }
  .highlights dd { margin: 4px 0 0; font-weight: 700; font-size: 16px; }
  .buy { --mx: 80%; --my: 0%; display: flex; flex-direction: column; gap: 16px; padding: 22px; border-radius: var(--radius); border: 1px solid rgba(255, 122, 26, 0.28);
    background: radial-gradient(420px circle at var(--mx) var(--my), rgba(255, 90, 31, 0.16), transparent 65%), var(--surface); }
  .price-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .price { font-family: var(--display); font-size: clamp(28px, 3vw, 36px); font-weight: 600; }
  .buy-buttons { display: grid; grid-template-columns: 1.3fr 1fr; gap: 10px; }
  .one-click { background: var(--heat); color: #fff; border-color: transparent; box-shadow: 0 10px 30px rgba(138, 59, 255, 0.25); }
  .one-click { position: relative; display: grid; grid-template-columns: auto 1fr; justify-items: start; column-gap: 12px; padding: 12px 18px; text-align: left; line-height: 1.25; overflow: hidden; }
  .one-click .bolt { grid-row: span 2; align-self: center; font-size: 22px; }
  .one-click small { font-weight: 500; font-size: 12.5px; opacity: 0.85; }
  .one-click::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.28) 50%, transparent 70%); translate: -100% 0; transition: translate 0.8s var(--ease); }
  .one-click:hover::after { translate: 100% 0; }
  .quick { display: inline-flex; align-items: center; gap: 8px; justify-self: center; font-size: 14px; color: var(--muted); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  .quick :global(.icon) { color: #25d366; }
  .quick:hover { color: var(--text); text-decoration-color: #25d366; }
  .sticky-actions { display: flex; gap: 8px; flex: none; }
  .perks { list-style: none; margin: 0; padding: 14px 0 0; border-top: 1px solid var(--line); display: grid; gap: 6px; font-size: 14px; color: #cfcdc8; }
  .perks li::before { content: '✓\FE0E'; color: var(--ok); margin-right: 10px; font-weight: 700; }

  .tabs { position: sticky; top: 108px; z-index: 5; display: flex; gap: 6px; margin-top: 56px; padding: 8px; border-radius: 999px; border: 1px solid var(--line); background: rgba(16, 18, 23, 0.85); backdrop-filter: blur(12px); overflow-x: auto; scrollbar-width: none; width: fit-content; max-width: calc(100% - 40px); }
  .tabs a { padding: 9px 16px; border-radius: 999px; font-weight: 700; font-size: 14px; white-space: nowrap; color: var(--muted); transition: color 0.2s, background-color 0.2s; }
  .tabs a:hover { color: var(--text); background: var(--surface-2); }
  .block { padding-top: 56px; scroll-margin-top: 170px; }
  .block > h2 { margin-bottom: 22px; }
  .prose { max-width: 820px; }
  .sub-h { font-size: 18px; margin: 32px 0 16px; }
  #video .section-head { margin-bottom: 20px; }

  .specs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: start; }
  .spec-group { border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); }
  .spec-group summary { list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 16px 18px; cursor: pointer; font-weight: 700; }
  .spec-group summary::-webkit-details-marker { display: none; }
  .spec-group summary span { width: 10px; height: 10px; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); rotate: 45deg; translate: 0 -3px; transition: rotate 0.3s var(--ease); }
  .spec-group[open] summary span { rotate: 225deg; translate: 0 2px; }
  .spec-group dl { margin: 0; padding: 0 18px 12px; }
  .spec-group dl div { display: grid; grid-template-columns: 1fr 1.1fr; gap: 16px; padding: 9px 0; border-top: 1px dashed var(--line); font-size: 14.5px; }
  .spec-group dt { color: var(--muted); }
  .spec-group dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }

  .range-note { margin: -8px 0 18px; font-size: 14px; }
  .table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .range { width: 100%; border-collapse: collapse; min-width: 520px; font-size: 15px; }
  .range th, .range td { padding: 13px 16px; text-align: left; border-top: 1px solid var(--line); }
  .range thead th { border-top: 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); background: var(--surface); }
  .range tbody th { font-weight: 600; }
  .range td { font-variant-numeric: tabular-nums; font-weight: 700; }
  .range tbody tr { transition: background-color 0.2s; }
  .range tbody tr:hover { background: rgba(255, 90, 31, 0.07); }

  .sticky-buy { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: rgba(16, 18, 23, 0.92); backdrop-filter: blur(12px); border-top: 1px solid var(--line); transform: translateY(110%); transition: transform 0.35s var(--ease); }
  .sticky-buy.is-visible { transform: none; }
  .sticky-inner { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; }
  .sticky-name { display: flex; flex-direction: column; font-weight: 600; font-size: 14px; line-height: 1.3; min-width: 0; }
  .sticky-name b { font-family: var(--display); font-weight: 600; font-size: 16px; }

  @media (max-width: 960px) {
    .product { grid-template-columns: 1fr; }
    .gallery { position: static; }
    .specs { grid-template-columns: 1fr; }
    .tabs { top: 72px; }
  }
  @media (max-width: 640px) {
    .tabs { top: 72px; margin-top: 40px; padding: 6px; }
    .tabs a { padding: 8px 12px; font-size: 13px; }
    .highlights dd { font-size: 15px; }
    .buy-buttons { grid-template-columns: 1fr; }
    .spec-group dl div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
